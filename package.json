{
  "name": "tetherbox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "node docker/dev/dev.mjs",
    "dev:daemon": "docker compose -f docker/dev/compose.yaml up --build",
    "dev:web": "pnpm --filter @tetherbox/web dev",
    "dev:token": "docker compose -f docker/dev/compose.yaml exec daemon cat /var/lib/tetherbox/app-token",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.1"
}
